<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="#1E293B">

    <TextView
        android:id="@+id/widget_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="WealthFlow Expense Tracker"
        android:textColor="#38BDF8"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_spending_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="This Month: $0.00"
        android:textColor="#F87171"
        android:textSize="15sp"
        android:textStyle="bold"
        android:layout_marginTop="2dp" />

    <TextView
        android:id="@+id/widget_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Tap below to record an expense"
        android:textColor="#94A3B8"
        android:textSize="10sp"
        android:layout_marginTop="2dp" />

    <Button
        android:id="@+id/widget_quick_add_btn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="+ Quick Add Expense"
        android:textColor="#FFFFFF"
        android:backgroundTint="#10B981" />
</LinearLayout>
